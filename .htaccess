# Si l'hébergeur ne permet pas de pointer le domaine sur /public,
# ce fichier redirige tout vers public/ et bloque le reste.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|bin|database|storage|migration|tests|docs)(/|$) - [F,L]
  RewriteRule ^(config\.php|config\.sample\.php|composer\.json|.*\.md)$ - [F,L]
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
